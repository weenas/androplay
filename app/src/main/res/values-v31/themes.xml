<resources>
    <!-- Android 12+ always shows its own splash (the app icon on a plain color) instead of the
         window background; match the image's dark background so the hand-over is seamless. -->
    <style name="Theme.CastBay.Starting">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
    </style>
</resources>
